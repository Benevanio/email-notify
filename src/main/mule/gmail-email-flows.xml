<?xml version="1.0" encoding="UTF-8"?>

<mule
    xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
    xmlns="http://www.mulesoft.org/schema/mule/core"
    xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core
        http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!--
        Fluxos de e-mail, thread e label. Todos somente leitura.
        Entradas (vars): gmailQuery, pageSize, pageToken | messageId | threadId
    -->

    <!-- Listagem com metadados: /emails, /emails/unread, /emails/search -->
    <sub-flow name="list-emails-flow">

        <flow-ref
            name="get-message-page-flow"
            doc:name="Get Message Page"/>

        <set-variable
            variableName="nextPageToken"
            value="#[payload.nextPageToken]"/>

        <set-variable
            variableName="resultSizeEstimate"
            value="#[payload.resultSizeEstimate default 0]"/>

        <set-variable
            variableName="messageIds"
            value="#[(payload.messages default []) map ((message) -> message.id)]"/>

        <parallel-foreach
            collection="#[vars.messageIds]"
            maxConcurrency="${gmail.maxConcurrency}"
            doc:name="Fetch Message Metadata">

            <set-variable
                variableName="messageId"
                value="#[payload]"/>

            <flow-ref
                name="get-message-metadata-flow"
                doc:name="Get Message Metadata"/>

        </parallel-foreach>

        <ee:transform doc:name="Normalize Messages">
            <ee:message>
                <ee:set-payload resource="dw/normalize-messages.dwl"/>
            </ee:message>
        </ee:transform>

        <ee:transform doc:name="Email Page">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    emails: payload,
    nextPageToken: vars.nextPageToken,
    resultSizeEstimate: vars.resultSizeEstimate
}
                ]]></ee:set-payload>
            </ee:message>
        </ee:transform>

    </sub-flow>

    <!-- Detalhe de uma mensagem: /emails/{id} -->
    <sub-flow name="get-email-detail-flow">

        <flow-ref
            name="get-message-full-flow"
            doc:name="Get Full Message"/>

        <ee:transform doc:name="Email Detail">
            <ee:message>
                <ee:set-payload resource="dw/message-detail.dwl"/>
            </ee:message>
        </ee:transform>

    </sub-flow>

    <!-- Conversa completa: /threads/{id} -->
    <sub-flow name="get-thread-flow">

        <flow-ref
            name="get-thread-metadata-flow"
            doc:name="Get Thread"/>

        <ee:transform doc:name="Thread Detail">
            <ee:message>
                <ee:set-payload resource="dw/thread-detail.dwl"/>
            </ee:message>
        </ee:transform>

    </sub-flow>

    <!-- Labels com contadores: /labels -->
    <sub-flow name="list-labels-flow">

        <flow-ref
            name="list-label-ids-flow"
            doc:name="List Label Ids"/>

        <set-variable
            variableName="labelIds"
            value="#[(payload.labels default []) map ((label) -> label.id)]"/>

        <parallel-foreach
            collection="#[vars.labelIds]"
            maxConcurrency="${gmail.maxConcurrency}"
            doc:name="Fetch Label Details">

            <set-variable
                variableName="labelId"
                value="#[payload]"/>

            <flow-ref
                name="get-label-flow"
                doc:name="Get Label"/>

            <ee:transform doc:name="Label Summary">
                <ee:message>
                    <ee:set-payload resource="dw/label-summary.dwl"/>
                </ee:message>
            </ee:transform>

        </parallel-foreach>

        <ee:transform doc:name="Label List">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    labels: payload
}
                ]]></ee:set-payload>
            </ee:message>
        </ee:transform>

    </sub-flow>

</mule>
