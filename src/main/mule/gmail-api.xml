<?xml version="1.0" encoding="UTF-8"?>

<mule
    xmlns:http="http://www.mulesoft.org/schema/mule/http"
    xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
    xmlns="http://www.mulesoft.org/schema/mule/core"
    xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http
        http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit
        http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd">

    <!-- Entrada única da API. O status HTTP vem de vars.httpStatus (definido pelo global-error-handler em erros). -->
    <flow name="gmail-intelligence-api-main">

        <http:listener
            config-ref="HTTP_Listener_Config"
            path="/api/*"
            doc:name="API Listener">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[{
                    'X-Correlation-Id': vars.correlationId default correlationId
                }]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:headers><![CDATA[#[{
                    'X-Correlation-Id': vars.correlationId default correlationId
                }]]]></http:headers>
            </http:error-response>
        </http:listener>

        <set-variable
            variableName="correlationId"
            value="#[correlationId]"
            doc:name="Set Correlation ID"/>

        <apikit:router
            config-ref="gmail-intelligence-api-config"
            doc:name="APIkit Router"/>

        <error-handler ref="global-error-handler"/>

    </flow>

    <!-- Implementações dos endpoints do RAML (nomes gerados pelo APIkit: método:\caminho:config) -->

    <flow name="get:\health:gmail-intelligence-api-config">
        <set-payload
            mimeType="application/json"
            doc:name="Health Response"
            value="#[{
                status: 'UP',
                service: p('app.name'),
                version: p('app.version'),
                environment: p('app.environment')
            }]"/>
    </flow>

    <flow name="get:\emails:gmail-intelligence-api-config">
        <set-variable variableName="gmailQuery" value="#[attributes.queryParams.q default p('gmail.defaultQuery')]"/>
        <set-variable variableName="pageSize" value="#[(attributes.queryParams.maxResults default p('gmail.defaultMaxResults')) as Number]"/>
        <set-variable variableName="pageToken" value="#[attributes.queryParams.pageToken]"/>
        <flow-ref name="list-emails-flow" doc:name="List Emails"/>
    </flow>

    <flow name="get:\emails\unread:gmail-intelligence-api-config">
        <set-variable variableName="gmailQuery" value="is:unread"/>
        <set-variable variableName="pageSize" value="#[(attributes.queryParams.maxResults default p('gmail.defaultMaxResults')) as Number]"/>
        <set-variable variableName="pageToken" value="#[attributes.queryParams.pageToken]"/>
        <flow-ref name="list-emails-flow" doc:name="List Unread Emails"/>
    </flow>

    <flow name="get:\emails\search:gmail-intelligence-api-config">
        <set-variable variableName="gmailQuery" value="#[attributes.queryParams.q]"/>
        <set-variable variableName="pageSize" value="#[(attributes.queryParams.maxResults default p('gmail.defaultMaxResults')) as Number]"/>
        <set-variable variableName="pageToken" value="#[attributes.queryParams.pageToken]"/>
        <flow-ref name="list-emails-flow" doc:name="Search Emails"/>
    </flow>

    <flow name="get:\emails\(id):gmail-intelligence-api-config">
        <set-variable variableName="messageId" value="#[attributes.uriParams.id]"/>
        <flow-ref name="get-email-detail-flow" doc:name="Get Email"/>
    </flow>

    <flow name="get:\threads\(id):gmail-intelligence-api-config">
        <set-variable variableName="threadId" value="#[attributes.uriParams.id]"/>
        <flow-ref name="get-thread-flow" doc:name="Get Thread"/>
    </flow>

    <flow name="get:\labels:gmail-intelligence-api-config">
        <flow-ref name="list-labels-flow" doc:name="List Labels"/>
    </flow>

    <flow name="post:\reports\emails:gmail-intelligence-api-config">
        <flow-ref name="generate-email-report-flow" doc:name="Generate Report"/>
    </flow>

    <flow name="get:\auth\google:gmail-intelligence-api-config">
        <flow-ref name="build-authorization-url-flow" doc:name="Authorization URL"/>
    </flow>

    <flow name="get:\auth\google\callback:gmail-intelligence-api-config">
        <set-variable variableName="oauthCode" value="#[attributes.queryParams.code]"/>
        <set-variable variableName="oauthState" value="#[attributes.queryParams.state]"/>
        <set-variable variableName="oauthError" value="#[attributes.queryParams.error]"/>
        <flow-ref name="handle-oauth-callback-flow" doc:name="OAuth Callback"/>
    </flow>

</mule>
