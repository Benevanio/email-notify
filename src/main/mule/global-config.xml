<?xml version="1.0" encoding="UTF-8"?>

<mule
    xmlns:http="http://www.mulesoft.org/schema/mule/http"
    xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
    xmlns:os="http://www.mulesoft.org/schema/mule/os"
    xmlns:file="http://www.mulesoft.org/schema/mule/file"
    xmlns:db="http://www.mulesoft.org/schema/mule/db"
    xmlns="http://www.mulesoft.org/schema/mule/core"
    xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http
        http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit
        http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
        http://www.mulesoft.org/schema/mule/os
        http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/file
        http://www.mulesoft.org/schema/mule/file/current/mule-file.xsd
        http://www.mulesoft.org/schema/mule/db
        http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd">

    <configuration-properties
        doc:name="Environment Configuration"
        file="env-dev.yaml"/>

    <http:listener-config
        name="HTTP_Listener_Config"
        doc:name="HTTP Listener Configuration">
        <http:listener-connection
            host="${http.host}"
            port="${http.port}"/>
    </http:listener-config>

    <apikit:config
        name="gmail-intelligence-api-config"
        api="api/gmail-intelligence-api.raml"
        outboundHeadersMapName="outboundHeaders"
        httpStatusVarName="httpStatus"/>

    <db:config name="Postgres_DB_Config" doc:name="PostgreSQL Config">
        <db:generic-connection
            url="jdbc:postgresql://${db.host}:${db.port}/${db.name}"
            driverClassName="org.postgresql.Driver"
            user="${db.user}"
            password="${db.password}"/>
    </db:config>

    <http:request-config
        name="Gmail_HTTP_Request_Config"
        doc:name="Gmail HTTP Request Configuration"
        basePath="${gmail.basePath}">
        <http:request-connection
            protocol="HTTPS"
            host="${gmail.host}"
            port="443"
            responseTimeout="${gmail.responseTimeoutMs}"
            responseTimeoutUnit="MILLISECONDS"/>
    </http:request-config>

    <http:request-config
        name="Google_Token_HTTP_Request_Config"
        doc:name="Google Token HTTP Request Configuration">
        <http:request-connection
            protocol="HTTPS"
            host="${google.tokenHost}"
            port="443"
            responseTimeout="30"
            responseTimeoutUnit="SECONDS"/>
    </http:request-config>

    <http:request-config
        name="WhatsApp_HTTP_Request_Config"
        doc:name="WhatsApp Cloud API Request Configuration">
        <http:request-connection
            protocol="HTTPS"
            host="${whatsapp.host}"
            port="443"
            responseTimeout="30"
            responseTimeoutUnit="SECONDS"/>
    </http:request-config>

    <os:object-store
        name="OAuth_State_Store"
        persistent="false"
        entryTtl="10"
        entryTtlUnit="MINUTES"/>

    <file:config name="File_Config" doc:name="File Config"/>

</mule>
