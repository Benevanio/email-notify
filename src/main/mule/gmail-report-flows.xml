<?xml version="1.0" encoding="UTF-8"?>

<mule
    xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
    xmlns:file="http://www.mulesoft.org/schema/mule/file"
    xmlns="http://www.mulesoft.org/schema/mule/core"
    xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core
        http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/file
        http://www.mulesoft.org/schema/mule/file/current/mule-file.xsd">

    <!--
        Relatório de e-mails (lido do Gmail, período e filtros do pedido).
        POST /reports/emails -> generate-email-report-flow (payload = corpo do pedido).
        Job diário -> daily-email-report-flow: gera, grava em disco e avisa pelo WhatsApp (template aprovado).
    -->

    <sub-flow name="generate-email-report-flow">

        <logger
            level="INFO"
            doc:name="Report Started"
            message="#['Relatório de e-mails iniciado. correlationId=' ++ (vars.correlationId default correlationId)]"/>

        <ee:transform doc:name="Validate Report Request">
            <ee:message>
                <ee:set-payload resource="dw/validate-report-request.dwl"/>
            </ee:message>
        </ee:transform>

        <choice doc:name="Request Is Valid?">
            <when expression="#[payload.valid == false]">
                <raise-error
                    type="VALIDATION:INVALID_INPUT"
                    description="#[payload.errors joinBy ' ']"/>
            </when>
        </choice>

        <set-variable
            variableName="reportRequest"
            value="#[payload.request]"/>

        <set-variable
            variableName="gmailQuery"
            value="#[trim((vars.reportRequest.query default '') ++ ' after:' ++ (((vars.reportRequest.startDate as Date) - |P1D|) as String {format: 'yyyy/MM/dd'}) ++ ' before:' ++ (((vars.reportRequest.endDate as Date) + |P2D|) as String {format: 'yyyy/MM/dd'}))]"/>

        <set-variable variableName="maxMessages" value="#[vars.reportRequest.maxEmails]"/>
        <set-variable variableName="configuredPageSize" value="#[p('gmail.pageSize') as Number]"/>
        <set-variable variableName="maxPages" value="#[p('gmail.maxListPages') as Number]"/>
        <set-variable variableName="collectedIds" value="#[[]]"/>
        <set-variable variableName="pageToken" value="#[null]"/>
        <set-variable variableName="pagesFetched" value="#[0]"/>

        <flow-ref
            name="collect-message-ids-flow"
            doc:name="Collect Message Ids"/>

        <set-variable
            variableName="collectionTruncated"
            value="#[vars.pageToken != null]"/>

        <parallel-foreach
            collection="#[vars.collectedIds]"
            maxConcurrency="${gmail.maxConcurrency}"
            doc:name="Fetch Message Metadata">

            <set-variable
                variableName="messageId"
                value="#[payload]"/>

            <flow-ref
                name="get-message-metadata-flow"
                doc:name="Get Message Metadata"/>

        </parallel-foreach>

        <ee:transform doc:name="Normalize Messages">
            <ee:message>
                <ee:set-payload resource="dw/normalize-messages.dwl"/>
            </ee:message>
        </ee:transform>

        <ee:transform doc:name="Prepare Report Input">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    request: vars.reportRequest,
    messages: payload,
    collection: {
        truncated: vars.collectionTruncated
    }
}
                ]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <ee:transform doc:name="Build Email Report">
            <ee:message>
                <ee:set-payload resource="dw/build-email-report.dwl"/>
            </ee:message>
        </ee:transform>

        <logger
            level="INFO"
            doc:name="Report Generated"
            message="#['Relatório gerado. Mensagens analisadas: ' ++ (payload.statistics.totalEmails as String) ++ '. correlationId=' ++ (vars.correlationId default correlationId)]"/>

    </sub-flow>

    <sub-flow name="collect-message-ids-flow">

        <choice doc:name="More Pages Needed?">
            <when expression="#[(vars.pagesFetched == 0 or vars.pageToken != null) and sizeOf(vars.collectedIds) < vars.maxMessages and vars.pagesFetched < vars.maxPages]">

                <set-variable
                    variableName="pageSize"
                    value="#[if ((vars.maxMessages - sizeOf(vars.collectedIds)) < vars.configuredPageSize) (vars.maxMessages - sizeOf(vars.collectedIds)) else vars.configuredPageSize]"/>

                <flow-ref
                    name="get-message-page-flow"
                    doc:name="Get Message Page"/>

                <set-variable
                    variableName="collectedIds"
                    value="#[(vars.collectedIds ++ ((payload.messages default []) map ((message) -> message.id))) filter ((id, index) -> index < vars.maxMessages)]"/>

                <set-variable
                    variableName="pageToken"
                    value="#[payload.nextPageToken]"/>

                <set-variable
                    variableName="pagesFetched"
                    value="#[vars.pagesFetched + 1]"/>

                <flow-ref
                    name="collect-message-ids-flow"
                    doc:name="Next Page"/>

            </when>
        </choice>

    </sub-flow>

    <flow name="daily-email-report-flow">

        <scheduler doc:name="Daily Report Schedule">
            <scheduling-strategy>
                <cron expression="${report.daily.cron}" timeZone="${report.timezone}"/>
            </scheduling-strategy>
        </scheduler>

        <set-variable
            variableName="correlationId"
            value="#[uuid()]"/>

        <ee:transform doc:name="Daily Report Request">
            <ee:message>
                <ee:set-payload resource="dw/build-daily-report-request.dwl"/>
            </ee:message>
        </ee:transform>

        <flow-ref
            name="generate-email-report-flow"
            doc:name="Generate Daily Report"/>

        <set-variable
            variableName="dailyReport"
            value="#[payload]"/>

        <file:write
            path="#[p('report.outputDir') ++ '/daily-report-' ++ vars.dailyReport.period.endDate ++ '.json']"
            createParentDirectories="true"
            doc:name="Save Daily Report">
            <file:content><![CDATA[#[write(vars.dailyReport, 'application/json')]]]></file:content>
        </file:write>

        <set-payload value="#[vars.dailyReport]"/>

        <ee:transform doc:name="Notification Parameters">
            <ee:message>
                <ee:set-payload resource="dw/build-report-notification.dwl"/>
            </ee:message>
        </ee:transform>

        <set-variable
            variableName="waParameters"
            value="#[payload]"/>

        <set-variable
            variableName="waTemplateName"
            value="#[p('whatsapp.dailyTemplateName')]"/>

        <flow-ref
            name="send-whatsapp-template-flow"
            doc:name="Notify Daily Report"/>

        <error-handler>
            <on-error-continue
                type="ANY"
                doc:name="Daily Report Failed">
                <logger
                    level="ERROR"
                    message="#['Falha no relatório diário. correlationId=' ++ (vars.correlationId default '') ++ ' erro=' ++ (error.errorType.namespace ++ ':' ++ error.errorType.identifier)]"/>
            </on-error-continue>
        </error-handler>

    </flow>

</mule>
